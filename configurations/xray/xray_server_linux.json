{
  //"log": { "loglevel": "none", "error": "none", "access": "none" }, //  "debug" | "info" | "warning" | "error" | "none"
  "log": { "loglevel": "error", "access": "/var/log/xray/access.log", "error": "/var/log/xray/error.log", "dnslog": true }, //遮掩IP地址 "maskAddress": "half", 

  "stats": {},
  "api": { "services": [ "StatsService" ], "tag": "api" },
  "policy": {
    "levels": { "0": { "statsUserUplink": true, "statsUserDownlink": true } },
    "system": { "statsInboundUplink": true, "statsInboundDownlink": true, "statsOutboundUplink": true, "statsOutboundDownlink": true }
  },

  "inbounds": [
    { "tag": "api-in", "listen": "127.0.0.1", "port": ${xray_api_port}, "protocol": "dokodemo-door", "settings": { "address": "127.0.0.1" } },
    { "tag": "dns-in-v4", "listen": "127.0.0.1", "port": 53, "protocol": "dokodemo-door", "settings": { "address": "127.0.0.1", "port": 53, "network": "tcp,udp" } },
    { "tag": "dns-in-v6", "listen": "::1", "port": 53, "protocol": "dokodemo-door", "settings": { "address": "::1", "port": 53, "network": "tcp,udp" } },
    {
      "tag": "proxy", "port": 443, "protocol": "vless",
      "sniffing": { "enabled": true, "destOverride": ["http","tls","quic"] },
      "settings": {
        "clients": [
          {
              "id": "${uuid_1}", // 必填，执行 ./xray uuid 生成，或 1-30 字节的字符串
              "email": "${user_1}", // 选填，区分用户
              "flow": "xtls-rprx-vision" // 选填，若有，客户端必须启用 XTLS
          },
          {
              "id": "${uuid_2}", // 必填，执行 ./xray uuid 生成，或 1-30 字节的字符串
              "email": "${user_2}", // 选填，区分用户
              "flow": "xtls-rprx-vision" // 选填，若有，客户端必须启用 XTLS
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp", "sockopt": {"tcpFastOpen": 32768}, "security": "reality",
        "realitySettings": {
            "dest": ${fallback_port_http}, // 必填，格式同 VLESS fallbacks 的 dest
            "xver": 1, // 选填，格式同 VLESS fallbacks 的 xver
            "serverNames": ["${x_domain}"], // 与 Nginx 配置中的 server_name 一致
            "privateKey": "${xray_privateKey}", // 必填，执行 ./xray x25519 生成
            "shortIds": ["${xray_shortIds}"] // 0 到 f，长度为 2 的倍数，长度上限为 16，可留空(客户端 shortId 可为空)，或执行 openssl rand -hex 8 生成
        }
      }
    }
  ],

  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "dns-out", "protocol": "dns" },
    { "tag": "block", "protocol": "blackhole" }
  ],

  "dns": {
    "queryStrategy": "UseIP",
    "servers": [
      "https://1.1.1.1/dns-query"
    ]
  },

  "routing": {
    "domainStrategy": "IPIfNonMatch", "domainMatcher": "hybrid",
    "rules": [
      { "outboundTag": "api", "inboundTag": "api-in" },
      { "outboundTag": "direct", "ip":["10.0.0.0/16"] },
      { "outboundTag": "dns-out", "inboundTag": ["dns-in-v4","dns-in-v6"] },
      { "outboundTag": "block", "ip": ["geoip:private","geoip:cn"] }
    ]
  }
}
